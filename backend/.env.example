# ─────────────────────────────────────────────────────────────────────────────
# AI Coding Mentor — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model to use. Run genai.list_models() to see what is available
# on your key. Recommended starting point for hackathon use:
GEMINI_MODEL=gemini-1.5-flash

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string-in-production

# ── CORS (comma-separated, no trailing slash) ─────────────────────────────────
# The frontend dev server origin. Adjust if you change the Vite port.
CORS_ORIGINS=http://localhost:5173

# ── Input limits ──────────────────────────────────────────────────────────────
MAX_CODE_LENGTH=8000
MAX_ERROR_LENGTH=2000
